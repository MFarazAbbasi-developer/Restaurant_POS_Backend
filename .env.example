# Server Configuration
NODE_ENV=development
# Bind address — default 127.0.0.1 keeps the initial desktop release local-only
HOST=127.0.0.1
PORT=5000
API_PREFIX=/api/v1

# Desktop persistent paths (optional — injected by Electron path abstraction)
# Production defaults: %ProgramData%\FARMAXPOS\{config,logs,postgres\data,backups}
# FARMAX_POS_* only (no legacy FARAZ_POS_* aliases).
# FARMAX_POS_CONFIG_FILE=C:\ProgramData\FARMAXPOS\config\desktop.env
# LOG_DIR=C:\ProgramData\FARMAXPOS\logs
# FARMAX_POS_DATA_DIR=C:\ProgramData\FARMAXPOS
# FARMAX_POS_POSTGRES_DATA_DIR=C:\ProgramData\FARMAXPOS\postgres\data
# FARMAX_POS_BACKUP_DIR=C:\ProgramData\FARMAXPOS\backups

# Database Configuration (PostgreSQL via Docker Compose)
# Fresh stacks: farmax_pos_db / container farmax_pos_postgres (see docker-compose.yml).
# DATABASE_URL is authoritative — point it at the database you actually use.
DATABASE_URL=postgresql://pos_admin:pos_password_123@localhost:5432/farmax_pos_db?schema=public

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging Configuration (fatal, error, warn, info, debug, trace)
LOG_LEVEL=debug

# Authentication & Security
JWT_ACCESS_SECRET=your_jwt_access_token_secret_min_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_SALT_ROUNDS=10

# Seeding (development / testing only)
# Required to run the destructive demo seed (TRUNCATE + demo restaurant data).
# Never set this on production or customer databases.
# Prefer: npm run prisma:seed:demo  (sets the flag via the CLI launcher)
# ALLOW_DESTRUCTIVE_SEED=1

# Licensing cloud / LAN host (Phase 2D.4) — optional; single-terminal POS boots without these.
# LICENSING_CLOUD_BASE_URL=https://licensing.example.com
# LICENSING_CLOUD_TIMEOUT_MS=10000
# LICENSING_CLOUD_MAX_RETRIES=2
# ENTITLEMENT_TRUSTED_PUBLIC_KEYS=keyId:spkiBase64url,...
# ENTITLEMENT_ISSUER=https://licensing.farmax.local
# ENTITLEMENT_AUDIENCE=farmax-pos
# ENTITLEMENT_REFRESH_INTERVAL_MS=3600000
# LAN_CLIENT_MAX_SKEW_MS=300000
# LAN_DEFAULT_RESTAURANT_ID=
# Loopback HTTPS (Phase 2D.6) — cert under FARMAX_POS_CONFIG_DIR/host-tls; never non-loopback
# HTTPS_PORT=5001
# LAN_HTTPS_ENABLED=1
#
# Remote (non-loopback) LAN exposure (Phase 2D.9) — DISABLED by default.
# Requires code latch REMOTE_LAN_EXPOSURE_READY=true AFTER a two-machine pilot,
# plus this env, valid TLS, and activated host. Env alone never opens the LAN.
# Never set on production hosts until pilot sign-off (docs/LAN_TWO_MACHINE_PILOT.md).
# To reverse: unset this variable and restart; keep HOST=127.0.0.1.
# FARMAX_POS_ALLOW_REMOTE_LAN=1
