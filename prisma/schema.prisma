// Faraz POS - Prisma Database Schema
// Multi-Tenant Restaurant Point of Sale & Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. Restaurant (Tenant)
// -----------------------------------------------------------------------------
model Restaurant {
  id                   String   @id @default(uuid())
  name                 String
  slug                 String   @unique
  legalName            String?
  phone                String?
  address              String?
  logo                 String?
  currency             String   @default("USD")
  timezone             String   @default("UTC")
  taxNumber            String?
  taxRate              Float    @default(0)
  taxInclusive         Boolean  @default(false)
  serviceChargeRate    Float    @default(0)
  serviceChargeEnabled Boolean  @default(false)
  dineInEnabled        Boolean  @default(true)
  takeawayEnabled      Boolean  @default(true)
  deliveryEnabled      Boolean  @default(true)
  receiptHeader        String?
  receiptFooter        String?
  settings             Json?    @db.JsonB
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relationships
  users          User[]
  roles          Role[]
  auditLogs      AuditLog[]
  categories     Category[]
  menuItems      MenuItem[]
  modifierGroups ModifierGroup[]

  @@index([slug])
  @@index([isActive])
  @@map("restaurants")
}

// -----------------------------------------------------------------------------
// 2. User
// -----------------------------------------------------------------------------
model User {
  id           String    @id @default(uuid())
  restaurantId String
  name         String
  username     String
  phone        String?
  pinHash      String
  passwordHash String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userRoles  UserRole[]
  sessions   Session[]
  auditLogs  AuditLog[]

  @@unique([restaurantId, username])
  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@map("users")
}

// -----------------------------------------------------------------------------
// 3. Role
// -----------------------------------------------------------------------------
model Role {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("roles")
}

// -----------------------------------------------------------------------------
// 4. Permission
// -----------------------------------------------------------------------------
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  rolePermissions RolePermission[]

  @@index([key])
  @@map("permissions")
}

// -----------------------------------------------------------------------------
// 5. UserRole (Join Table: User <-> Role)
// -----------------------------------------------------------------------------
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// -----------------------------------------------------------------------------
// 6. RolePermission (Join Table: Role <-> Permission)
// -----------------------------------------------------------------------------
model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  // Relationships
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// 7. Session
// -----------------------------------------------------------------------------
model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// 8. AuditLog
// -----------------------------------------------------------------------------
model AuditLog {
  id           String   @id @default(uuid())
  restaurantId String
  userId       String?
  action       String
  entityType   String
  entityId     String?
  metadata     Json?    @db.JsonB
  ipAddress    String?
  createdAt    DateTime @default(now())

  // Relationships
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([userId])
  @@index([restaurantId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// 9. Category (Menu Category)
// -----------------------------------------------------------------------------
model Category {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@index([restaurantId])
  @@index([restaurantId, isActive, sortOrder])
  @@map("categories")
}

// -----------------------------------------------------------------------------
// 10. MenuItem
// -----------------------------------------------------------------------------
model MenuItem {
  id           String   @id @default(uuid())
  restaurantId String
  categoryId   String
  itemCode     String
  name         String
  urduName     String?
  description  String?
  basePrice    Decimal  @default(0) @db.Decimal(10, 2)
  taxRate      Decimal? @db.Decimal(5, 2)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  restaurant     Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category       Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants       MenuItemVariant[]
  modifierGroups MenuItemModifierGroup[]

  @@unique([restaurantId, itemCode])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, categoryId, isActive, isAvailable, sortOrder])
  @@map("menu_items")
}

// -----------------------------------------------------------------------------
// 11. MenuItemVariant (Portion / Price Variants)
// -----------------------------------------------------------------------------
model MenuItemVariant {
  id         String   @id @default(uuid())
  menuItemId String
  name       String
  price      Decimal  @db.Decimal(10, 2)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@index([menuItemId, isActive, sortOrder])
  @@map("menu_item_variants")
}

// -----------------------------------------------------------------------------
// 12. ModifierGroup & SelectionType Enum
// -----------------------------------------------------------------------------
enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

model ModifierGroup {
  id            String                @id @default(uuid())
  restaurantId  String
  name          String
  selectionType ModifierSelectionType @default(SINGLE)
  minSelections Int                   @default(0)
  maxSelections Int                   @default(1)
  sortOrder     Int                   @default(0)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  // Relationships
  restaurant Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifiers  Modifier[]
  menuItems  MenuItemModifierGroup[]

  @@index([restaurantId])
  @@index([restaurantId, isActive, sortOrder])
  @@map("modifier_groups")
}

// -----------------------------------------------------------------------------
// 13. Modifier (Individual Option within a Group)
// -----------------------------------------------------------------------------
model Modifier {
  id              String   @id @default(uuid())
  modifierGroupId String
  name            String
  priceAdjustment Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([modifierGroupId])
  @@index([modifierGroupId, isActive, sortOrder])
  @@map("modifiers")
}

// -----------------------------------------------------------------------------
// 14. MenuItemModifierGroup (Join Table: MenuItem <-> ModifierGroup)
// -----------------------------------------------------------------------------
model MenuItemModifierGroup {
  id              String   @id @default(uuid())
  menuItemId      String
  modifierGroupId String
  sortOrder       Int      @default(0)
  isRequired      Boolean  @default(false)
  minSelections   Int?
  maxSelections   Int?
  createdAt       DateTime @default(now())

  // Relationships
  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([menuItemId])
  @@index([modifierGroupId])
  @@index([menuItemId, sortOrder])
  @@map("menu_item_modifier_groups")
}
