// FARMAX POS - Prisma Database Schema
// Multi-Tenant Restaurant Point of Sale & Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. Restaurant (Tenant)
// -----------------------------------------------------------------------------
model Restaurant {
  id                   String   @id @default(uuid())
  name                 String
  slug                 String   @unique
  legalName            String?
  phone                String?
  address              String?
  logo                 String?
  currency             String   @default("PKR")
  timezone             String   @default("Asia/Karachi")
  taxNumber            String?
  taxRate              Float    @default(0)
  taxInclusive         Boolean  @default(false)
  serviceChargeRate    Float    @default(0)
  serviceChargeEnabled Boolean  @default(false)
  dineInEnabled        Boolean  @default(true)
  takeawayEnabled      Boolean  @default(true)
  deliveryEnabled      Boolean  @default(true)
  receiptHeader        String?
  receiptFooter        String?
  settings             Json?    @db.JsonB
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relationships
  users          User[]
  roles          Role[]
  auditLogs      AuditLog[]
  categories             Category[]
  menuItems              MenuItem[]
  modifierGroups         ModifierGroup[]
  zones                  Zone[]
  tables                 RestaurantTable[]
  tableOrders            TableOrder[]
  takeawayOrders         TakeawayOrder[]
  takeawayDailySequences TakeawayDailySequence[]
  customers              Customer[]
  deliveryZones          DeliveryZone[]
  deliveryOrders         DeliveryOrder[]
  deliveryDailySequences DeliveryDailySequence[]
  riderSettlements       RiderSettlement[]
  orders                 Order[]
  dailyOrderSequences    DailyOrderSequence[]
  cashierShifts          CashierShift[]
  payments               Payment[]
  paymentRefunds         PaymentRefund[]
  cashTransactions       CashTransaction[]
  kitchenStations        KitchenStation[]
  stockLocations         StockLocation[]
  suppliers              Supplier[]
  inventoryItems         InventoryItem[]
  menuItemIngredients    MenuItemIngredient[]
  stockMovements         StockMovement[]
  purchaseOrders         PurchaseOrder[]
  stockAdjustments       StockAdjustment[]
  stockWastages          StockWastage[]
  stockTransfers         StockTransfer[]
  promotions             Promotion[]
  promotionUsages        PromotionUsage[]
  loyaltyProgram         LoyaltyProgram?
  loyaltyTiers           LoyaltyTier[]
  loyaltyAccounts        LoyaltyAccount[]
  loyaltyTransactions    LoyaltyTransaction[]
  reservations           Reservation[]
  purchaseReturns        PurchaseReturn[]
  expenseCategories      ExpenseCategory[]
  expenses               Expense[]

  @@index([slug])
  @@index([isActive])
  @@map("restaurants")
}

// -----------------------------------------------------------------------------
// 2. User
// -----------------------------------------------------------------------------
model User {
  id           String    @id @default(uuid())
  restaurantId String
  name         String
  username     String
  phone        String?
  pinHash      String
  passwordHash String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  restaurant        Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userRoles         UserRole[]
  sessions          Session[]
  auditLogs         AuditLog[]
  openedTableOrders          TableOrder[]
  createdTakeawayOrders      TakeawayOrder[]
  assignedDeliveries         DeliveryOrder[]   @relation("RiderDeliveries")
  createdDeliveryOrders      DeliveryOrder[]   @relation("CreatedDeliveryOrders")
  riderSettlements           RiderSettlement[] @relation("RiderSettlements")
  receivedRiderSettlements   RiderSettlement[] @relation("ReceivedRiderSettlements")
  createdOrders              Order[]           @relation("CreatedOrders")
  voidedOrders               Order[]           @relation("VoidedOrders")
  assignedOrders             Order[]           @relation("OrderRider")
  cashierShifts              CashierShift[]    @relation("CashierShifts")
  closedShifts               CashierShift[]    @relation("ClosedShifts")
  createdPayments            Payment[]         @relation("CreatedPayments")
  createdRefunds             PaymentRefund[]   @relation("CreatedRefunds")
  cashTransactions           CashTransaction[] @relation("CashTransactions")
  createdStockMovements      StockMovement[]   @relation("CreatedStockMovements")
  createdPurchaseOrders      PurchaseOrder[]   @relation("CreatedPurchaseOrders")
  createdStockAdjustments    StockAdjustment[] @relation("CreatedStockAdjustments")
  createdStockWastages       StockWastage[]    @relation("CreatedStockWastages")
  createdStockTransfers      StockTransfer[]   @relation("CreatedStockTransfers")
  createdLoyaltyTransactions LoyaltyTransaction[] @relation("CreatedLoyaltyTransactions")
  createdReservations        Reservation[]     @relation("CreatedReservations")
  createdPurchaseReturns     PurchaseReturn[]  @relation("CreatedPurchaseReturns")
  createdExpenses            Expense[]         @relation("CreatedExpenses")
  voidedExpenses             Expense[]         @relation("VoidedExpenses")

  @@unique([restaurantId, username])
  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@map("users")
}

// -----------------------------------------------------------------------------
// 3. Role
// -----------------------------------------------------------------------------
model Role {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("roles")
}

// -----------------------------------------------------------------------------
// 4. Permission
// -----------------------------------------------------------------------------
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  rolePermissions RolePermission[]

  @@index([key])
  @@map("permissions")
}

// -----------------------------------------------------------------------------
// 5. UserRole (Join Table: User <-> Role)
// -----------------------------------------------------------------------------
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// -----------------------------------------------------------------------------
// 6. RolePermission (Join Table: Role <-> Permission)
// -----------------------------------------------------------------------------
model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  // Relationships
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// 7. Session
// -----------------------------------------------------------------------------
model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// 8. AuditLog
// -----------------------------------------------------------------------------
model AuditLog {
  id           String   @id @default(uuid())
  restaurantId String
  userId       String?
  action       String
  entityType   String
  entityId     String?
  metadata     Json?    @db.JsonB
  ipAddress    String?
  createdAt    DateTime @default(now())

  // Relationships
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([userId])
  @@index([restaurantId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// 9. Category (Menu Category)
// -----------------------------------------------------------------------------
model Category {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  restaurant      Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems       MenuItem[]
  kitchenStations CategoryKitchenStation[]
  promotions      PromotionCategory[]

  @@index([restaurantId])
  @@index([restaurantId, isActive, sortOrder])
  @@map("categories")
}

// -----------------------------------------------------------------------------
// 10. MenuItem
// -----------------------------------------------------------------------------
model MenuItem {
  id           String   @id @default(uuid())
  restaurantId String
  categoryId   String
  itemCode     String
  name         String
  urduName     String?
  description  String?
  basePrice    Decimal  @default(0) @db.Decimal(10, 2)
  taxRate      Decimal? @db.Decimal(5, 2)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  restaurant     Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category       Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants               MenuItemVariant[]
  modifierGroups         MenuItemModifierGroup[]
  takeawayOrderItems     TakeawayOrderItem[]
  deliveryOrderItems     DeliveryOrderItem[]
  orderItems             OrderItem[]
  ingredients            MenuItemIngredient[]
  promotions             PromotionMenuItem[]

  @@unique([restaurantId, itemCode])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, categoryId, isActive, isAvailable, sortOrder])
  @@map("menu_items")
}

// -----------------------------------------------------------------------------
// 11. MenuItemVariant (Portion / Price Variants)
// -----------------------------------------------------------------------------
model MenuItemVariant {
  id         String   @id @default(uuid())
  menuItemId String
  name       String
  price      Decimal  @db.Decimal(10, 2)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  menuItem           MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  takeawayOrderItems TakeawayOrderItem[]
  deliveryOrderItems DeliveryOrderItem[]
  orderItems         OrderItem[]
  ingredients        MenuItemIngredient[]

  @@index([menuItemId])
  @@index([menuItemId, isActive, sortOrder])
  @@map("menu_item_variants")
}

// -----------------------------------------------------------------------------
// 12. ModifierGroup & SelectionType Enum
// -----------------------------------------------------------------------------
enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

model ModifierGroup {
  id            String                @id @default(uuid())
  restaurantId  String
  name          String
  selectionType ModifierSelectionType @default(SINGLE)
  minSelections Int                   @default(0)
  maxSelections Int                   @default(1)
  sortOrder     Int                   @default(0)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  // Relationships
  restaurant Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifiers  Modifier[]
  menuItems  MenuItemModifierGroup[]

  @@index([restaurantId])
  @@index([restaurantId, isActive, sortOrder])
  @@map("modifier_groups")
}

// -----------------------------------------------------------------------------
// 13. Modifier (Individual Option within a Group)
// -----------------------------------------------------------------------------
model Modifier {
  id              String   @id @default(uuid())
  modifierGroupId String
  name            String
  priceAdjustment Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  modifierGroup      ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]
  ingredients        MenuItemIngredient[]

  @@index([modifierGroupId])
  @@index([modifierGroupId, isActive, sortOrder])
  @@map("modifiers")
}

// -----------------------------------------------------------------------------
// 14. MenuItemModifierGroup (Join Table: MenuItem <-> ModifierGroup)
// -----------------------------------------------------------------------------
model MenuItemModifierGroup {
  id              String   @id @default(uuid())
  menuItemId      String
  modifierGroupId String
  sortOrder       Int      @default(0)
  isRequired      Boolean  @default(false)
  minSelections   Int?
  maxSelections   Int?
  createdAt       DateTime @default(now())

  // Relationships
  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([menuItemId])
  @@index([modifierGroupId])
  @@index([menuItemId, sortOrder])
  @@map("menu_item_modifier_groups")
}

// -----------------------------------------------------------------------------
// 15. Zone (Seating Floor / Dining Area)
// -----------------------------------------------------------------------------
model Zone {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     RestaurantTable[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, isActive, sortOrder])
  @@map("zones")
}

// -----------------------------------------------------------------------------
// 16. RestaurantTable (Dining Table)
// -----------------------------------------------------------------------------
enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILL_PRINTED
  RESERVED
  CLEANING
}

model RestaurantTable {
  id                String      @id @default(uuid())
  restaurantId      String
  zoneId            String
  name              String
  capacity          Int         @default(4)
  sortOrder         Int         @default(0)
  status            TableStatus @default(AVAILABLE)
  mergedIntoTableId String?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relationships
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  zone            Zone              @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  mergedIntoTable RestaurantTable?  @relation("TableMerges", fields: [mergedIntoTableId], references: [id], onDelete: SetNull)
  mergedTables    RestaurantTable[] @relation("TableMerges")
  tableOrders     TableOrder[]
  orders          Order[]
  reservations    Reservation[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([zoneId])
  @@index([mergedIntoTableId])
  @@index([restaurantId, zoneId, isActive, sortOrder])
  @@index([restaurantId, status])
  @@map("tables")
}

// -----------------------------------------------------------------------------
// 17. TableOrder (Active Table Orders / Sub-bills)
// -----------------------------------------------------------------------------
enum TableOrderStatus {
  ACTIVE
  BILL_PRINTED
  CLOSED
  CANCELLED
}

model TableOrder {
  id             String           @id @default(uuid())
  restaurantId   String
  tableId        String
  orderCode      String
  subBillName    String?
  guestCount     Int              @default(1)
  status         TableOrderStatus @default(ACTIVE)
  totalAmount    Decimal          @default(0) @db.Decimal(10, 2)
  openedByUserId String?
  openedAt       DateTime         @default(now())
  closedAt       DateTime?
  metadata       Json?            @db.JsonB
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relationships
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  openedByUser User?           @relation(fields: [openedByUserId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@unique([restaurantId, orderCode])
  @@index([restaurantId])
  @@index([tableId])
  @@index([restaurantId, tableId, status])
  @@map("table_orders")
}

// -----------------------------------------------------------------------------
// 18. Takeaway Management Models
// -----------------------------------------------------------------------------
enum TakeawayOrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum TakeawayPaymentStatus {
  PAID
  PENDING
}

model TakeawayOrder {
  id                  String                @id @default(uuid())
  restaurantId        String
  tokenNumber         Int
  orderCode           String
  businessDate        String
  customerName        String
  customerPhone       String?
  status              TakeawayOrderStatus   @default(PENDING)
  paymentStatus       TakeawayPaymentStatus @default(PAID)
  paymentMethod       String                @default("CASH")
  subtotal            Decimal               @db.Decimal(10, 2)
  taxRate             Decimal?              @db.Decimal(5, 2)
  taxAmount           Decimal               @default(0) @db.Decimal(10, 2)
  discountAmount      Decimal               @default(0) @db.Decimal(10, 2)
  totalAmount         Decimal               @db.Decimal(10, 2)
  isPayOnPickup       Boolean               @default(false)
  specialInstructions String?
  cancelReason        String?
  createdById         String?
  completedAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  // Relationships
  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdByUser User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items      TakeawayOrderItem[]

  @@unique([restaurantId, orderCode])
  @@unique([restaurantId, businessDate, tokenNumber])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, businessDate])
  @@index([restaurantId, createdAt])
  @@map("takeaway_orders")
}

model TakeawayOrderItem {
  id                  String   @id @default(uuid())
  takeawayOrderId     String
  menuItemId          String
  variantId           String?
  name                String
  variantName         String?
  quantity            Int      @default(1)
  unitPrice           Decimal  @db.Decimal(10, 2)
  subtotal            Decimal  @db.Decimal(10, 2)
  specialInstructions String?
  modifiers           Json?    @db.JsonB
  createdAt           DateTime @default(now())

  // Relationships
  takeawayOrder TakeawayOrder    @relation(fields: [takeawayOrderId], references: [id], onDelete: Cascade)
  menuItem      MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  variant       MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([takeawayOrderId])
  @@index([menuItemId])
  @@map("takeaway_order_items")
}

model TakeawayDailySequence {
  id              String   @id @default(uuid())
  restaurantId    String
  businessDate    String
  lastTokenNumber Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, businessDate])
  @@index([restaurantId])
  @@map("takeaway_daily_sequences")
}

// -----------------------------------------------------------------------------
// 19. Customer & Address Foundation
// -----------------------------------------------------------------------------
model Customer {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  phone        String
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  addresses       CustomerAddress[]
  deliveryOrders  DeliveryOrder[]
  orders          Order[]
  promotions      Promotion[]
  promotionUsages PromotionUsage[]
  loyaltyAccount  LoyaltyAccount?
  loyaltyTransactions LoyaltyTransaction[]
  reservations    Reservation[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([restaurantId, phone])
  @@map("customers")
}

model CustomerAddress {
  id             String   @id @default(uuid())
  customerId     String
  address        String
  landmark       String?
  deliveryZoneId String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("customer_addresses")
}

// -----------------------------------------------------------------------------
// 20. Delivery Zones & Delivery Pricing
// -----------------------------------------------------------------------------
model DeliveryZone {
  id               String   @id @default(uuid())
  restaurantId     String
  name             String
  deliveryCharge   Decimal  @default(0) @db.Decimal(10, 2)
  estimatedMinutes Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  restaurant        Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerAddresses CustomerAddress[]
  deliveryOrders    DeliveryOrder[]
  orders            Order[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("delivery_zones")
}

// -----------------------------------------------------------------------------
// 21. Delivery Orders & Delivery Lifecycle
// -----------------------------------------------------------------------------
enum DeliveryOrderStatus {
  PENDING
  PREPARING
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
  FAILED
}

enum DeliveryPaymentStatus {
  PENDING
  PAID
}

model DeliveryOrder {
  id                  String                @id @default(uuid())
  restaurantId        String
  orderCode           String
  businessDate        String
  customerId          String?
  customerName        String
  customerPhone       String
  deliveryAddress     String
  landmark            String?
  deliveryZoneId      String?
  deliveryZoneName    String?
  deliveryCharge      Decimal               @default(0) @db.Decimal(10, 2)
  packagingCharge     Decimal               @default(0) @db.Decimal(10, 2)
  subtotal            Decimal               @db.Decimal(10, 2)
  taxRate             Decimal?              @db.Decimal(5, 2)
  taxAmount           Decimal               @default(0) @db.Decimal(10, 2)
  discountAmount      Decimal               @default(0) @db.Decimal(10, 2)
  totalAmount         Decimal               @db.Decimal(10, 2)
  paymentStatus       DeliveryPaymentStatus @default(PENDING)
  paymentMethod       String                @default("CASH")
  status              DeliveryOrderStatus   @default(PENDING)
  riderId             String?
  assignedAt          DateTime?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  specialInstructions String?
  isAggregator        Boolean               @default(false)
  aggregatorName      String?
  aggregatorReference String?
  isSettled           Boolean               @default(false)
  settledAt           DateTime?
  createdById         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  // Relationships
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer     Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryZone DeliveryZone?       @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  rider        User?               @relation("RiderDeliveries", fields: [riderId], references: [id], onDelete: SetNull)
  createdByUser User?              @relation("CreatedDeliveryOrders", fields: [createdById], references: [id], onDelete: SetNull)
  items        DeliveryOrderItem[]

  @@unique([restaurantId, orderCode])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, riderId, status])
  @@index([restaurantId, businessDate])
  @@index([restaurantId, createdAt])
  @@map("delivery_orders")
}

model DeliveryOrderItem {
  id                  String   @id @default(uuid())
  deliveryOrderId     String
  menuItemId          String
  variantId           String?
  name                String
  variantName         String?
  quantity            Int      @default(1)
  unitPrice           Decimal  @db.Decimal(10, 2)
  subtotal            Decimal  @db.Decimal(10, 2)
  specialInstructions String?
  modifiers           Json?    @db.JsonB
  createdAt           DateTime @default(now())

  // Relationships
  deliveryOrder DeliveryOrder    @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  menuItem      MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  variant       MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([deliveryOrderId])
  @@index([menuItemId])
  @@map("delivery_order_items")
}

model DeliveryDailySequence {
  id              String   @id @default(uuid())
  restaurantId    String
  businessDate    String
  lastOrderNumber Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, businessDate])
  @@index([restaurantId])
  @@map("delivery_daily_sequences")
}

// -----------------------------------------------------------------------------
// 22. Rider Cash Reconciliation & Settlement Ledger
// -----------------------------------------------------------------------------
model RiderSettlement {
  id              String   @id @default(uuid())
  restaurantId    String
  riderId         String
  receivedById    String
  businessDate    String
  expectedAmount  Decimal  @db.Decimal(10, 2)
  collectedAmount Decimal  @db.Decimal(10, 2)
  remittedAmount  Decimal  @db.Decimal(10, 2)
  varianceAmount  Decimal  @default(0) @db.Decimal(10, 2)
  ordersCount     Int
  orderIds        Json     @db.JsonB
  notes           String?
  settledAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  // Relationships
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rider        User       @relation("RiderSettlements", fields: [riderId], references: [id], onDelete: Restrict)
  receivedByUser User     @relation("ReceivedRiderSettlements", fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([restaurantId])
  @@index([restaurantId, riderId])
  @@index([restaurantId, businessDate])
  @@map("rider_settlements")
}

// -----------------------------------------------------------------------------
// 23. Core Order & Billing Unified Models
// -----------------------------------------------------------------------------
enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
  VOIDED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderItemStatus {
  ACTIVE
  VOIDED
}

enum ItemKitchenStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

model Order {
  id                  String             @id @default(uuid())
  restaurantId        String
  orderCode           String
  businessDate        String
  orderType           OrderType          @default(DINE_IN)
  status              OrderStatus        @default(PENDING)
  paymentStatus       OrderPaymentStatus @default(UNPAID)
  paymentMethod       String?            @default("CASH")

  // Financial Breakdown
  subtotal            Decimal            @default(0) @db.Decimal(10, 2)
  itemDiscountsTotal  Decimal            @default(0) @db.Decimal(10, 2)
  orderDiscountType   DiscountType?
  orderDiscountValue  Decimal?           @db.Decimal(10, 2)
  orderDiscountAmount Decimal            @default(0) @db.Decimal(10, 2)
  orderDiscountReason String?
  promoCode           String?
  promotionDiscount   Decimal            @default(0) @db.Decimal(10, 2)
  loyaltyPointsRedeemed Int              @default(0)
  loyaltyDiscount     Decimal            @default(0) @db.Decimal(10, 2)
  totalDiscount       Decimal            @default(0) @db.Decimal(10, 2)
  taxRate             Decimal?           @db.Decimal(5, 2)
  taxInclusive        Boolean            @default(false)
  taxAmount           Decimal            @default(0) @db.Decimal(10, 2)
  serviceChargeRate   Decimal?           @db.Decimal(5, 2)
  serviceChargeAmount Decimal            @default(0) @db.Decimal(10, 2)
  deliveryCharge      Decimal            @default(0) @db.Decimal(10, 2)
  packagingCharge     Decimal            @default(0) @db.Decimal(10, 2)
  roundingAmount      Decimal            @default(0) @db.Decimal(10, 2)
  grandTotal          Decimal            @default(0) @db.Decimal(10, 2)
  paidAmount          Decimal            @default(0) @db.Decimal(10, 2)
  changeAmount        Decimal            @default(0) @db.Decimal(10, 2)

  // Contextual Channel References
  tableId             String?
  tableOrderId        String?
  guestCount          Int?               @default(1)
  tokenNumber         Int?
  customerId          String?
  customerName        String?
  customerPhone       String?
  deliveryAddress     String?
  deliveryZoneId      String?
  riderId             String?
  isAggregator        Boolean            @default(false)
  aggregatorName      String?
  aggregatorReference String?

  // Lifecycle, Reason & Audit
  notes               String?
  cancelReason        String?
  voidReason          String?
  createdById         String?
  voidedById          String?
  closedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relationships
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table               RestaurantTable?   @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableOrder          TableOrder?        @relation(fields: [tableOrderId], references: [id], onDelete: SetNull)
  customer            Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryZone        DeliveryZone?      @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  rider               User?              @relation("OrderRider", fields: [riderId], references: [id], onDelete: SetNull)
  createdByUser       User?              @relation("CreatedOrders", fields: [createdById], references: [id], onDelete: SetNull)
  voidedByUser        User?              @relation("VoidedOrders", fields: [voidedById], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  refunds             PaymentRefund[]
  promotionUsages     PromotionUsage[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([restaurantId, orderCode])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, orderType])
  @@index([restaurantId, tableId, status])
  @@index([restaurantId, businessDate])
  @@index([restaurantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String             @id @default(uuid())
  orderId             String
  menuItemId          String
  variantId           String?
  stationId           String?
  itemName            String
  variantName         String?
  quantity            Int                @default(1)
  unitPrice           Decimal            @db.Decimal(10, 2)
  modifiersPrice      Decimal            @default(0) @db.Decimal(10, 2)
  itemGrossTotal      Decimal            @default(0) @db.Decimal(10, 2)
  discountType        DiscountType?
  discountValue       Decimal?           @db.Decimal(10, 2)
  discountAmount      Decimal            @default(0) @db.Decimal(10, 2)
  promotionDiscount   Decimal            @default(0) @db.Decimal(10, 2)
  itemNetTotal        Decimal            @default(0) @db.Decimal(10, 2)
  status              OrderItemStatus    @default(ACTIVE)
  kitchenStatus       ItemKitchenStatus  @default(PENDING)
  preparedAt          DateTime?
  kitchenNotes        String?
  voidReason          String?
  voidedAt            DateTime?
  specialInstructions String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relationships
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem            MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  variant             MenuItemVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  station             KitchenStation?    @relation(fields: [stationId], references: [id], onDelete: SetNull)
  modifiers           OrderItemModifier[]

  @@index([orderId])
  @@index([menuItemId])
  @@index([stationId])
  @@index([kitchenStatus])
  @@map("order_items")
}

model OrderItemModifier {
  id              String   @id @default(uuid())
  orderItemId     String
  modifierId      String
  modifierGroupId String?
  name            String
  priceAdjustment Decimal  @default(0) @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  // Relationships
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier        Modifier  @relation(fields: [modifierId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([modifierId])
  @@map("order_item_modifiers")
}

model DailyOrderSequence {
  id              String   @id @default(uuid())
  restaurantId    String
  businessDate    String
  lastOrderNumber Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, businessDate])
  @@index([restaurantId])
  @@map("daily_order_sequences")
}

// -----------------------------------------------------------------------------
// 24. Payments & Cash Management Models
// -----------------------------------------------------------------------------
enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  DIGITAL_WALLET
  OTHER
}

enum PaymentStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashTransactionType {
  OPENING_FLOAT
  CASH_SALE
  CASH_REFUND
  CASH_DROP
  PAY_IN
  PAY_OUT
  EXPENSE
}

model CashierShift {
  id                  String            @id @default(uuid())
  restaurantId        String
  cashierId           String
  registerName        String            @default("Main Register")
  businessDate        String
  status              ShiftStatus       @default(OPEN)
  openedAt            DateTime          @default(now())
  closedAt            DateTime?
  openingCash         Decimal           @default(0) @db.Decimal(10, 2)
  cashSales           Decimal           @default(0) @db.Decimal(10, 2)
  cashRefunds         Decimal           @default(0) @db.Decimal(10, 2)
  cashDrops           Decimal           @default(0) @db.Decimal(10, 2)
  cashAdjustments     Decimal           @default(0) @db.Decimal(10, 2)
  expectedClosingCash Decimal?          @db.Decimal(10, 2)
  actualClosingCash   Decimal?          @db.Decimal(10, 2)
  variance            Decimal?          @db.Decimal(10, 2)
  closedById          String?
  notes               String?
  closingNotes        String?
  cashExpenses        Decimal           @default(0) @db.Decimal(10, 2)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relationships
  restaurant          Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cashier             User              @relation("CashierShifts", fields: [cashierId], references: [id], onDelete: Restrict)
  closedByUser        User?             @relation("ClosedShifts", fields: [closedById], references: [id], onDelete: SetNull)
  payments            Payment[]
  refunds             PaymentRefund[]
  cashTransactions    CashTransaction[]
  expenses            Expense[]

  @@index([restaurantId])
  @@index([restaurantId, cashierId, status])
  @@index([restaurantId, businessDate])
  @@index([restaurantId, status])
  @@map("cashier_shifts")
}

model Payment {
  id              String            @id @default(uuid())
  restaurantId    String
  orderId         String
  shiftId         String?
  paymentMethod   PaymentMethod     @default(CASH)
  amount          Decimal           @db.Decimal(10, 2)
  amountTendered  Decimal?          @db.Decimal(10, 2)
  changeAmount    Decimal?          @db.Decimal(10, 2)
  reference       String?
  cardLast4       String?
  cardBrand       String?
  status          PaymentStatus     @default(COMPLETED)
  refundedAmount  Decimal           @default(0) @db.Decimal(10, 2)
  notes           String?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shift           CashierShift?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdByUser   User?             @relation("CreatedPayments", fields: [createdById], references: [id], onDelete: SetNull)
  refunds         PaymentRefund[]
  cashTransaction CashTransaction?

  @@index([restaurantId])
  @@index([restaurantId, orderId])
  @@index([restaurantId, shiftId])
  @@index([restaurantId, paymentMethod])
  @@index([restaurantId, status])
  @@index([restaurantId, reference])
  @@index([restaurantId, createdAt])
  @@map("payments")
}

model PaymentRefund {
  id                 String           @id @default(uuid())
  restaurantId       String
  paymentId          String
  orderId            String
  shiftId            String?
  amount             Decimal          @db.Decimal(10, 2)
  reason             String
  refundMethod       PaymentMethod    @default(CASH)
  reference          String?
  managerPinVerified Boolean          @default(false)
  createdById        String?
  createdAt          DateTime         @default(now())

  // Relationships
  restaurant         Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payment            Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shift              CashierShift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdByUser      User?            @relation("CreatedRefunds", fields: [createdById], references: [id], onDelete: SetNull)
  cashTransaction    CashTransaction?

  @@index([restaurantId])
  @@index([restaurantId, paymentId])
  @@index([restaurantId, orderId])
  @@index([restaurantId, shiftId])
  @@index([restaurantId, createdAt])
  @@map("payment_refunds")
}

model CashTransaction {
  id           String              @id @default(uuid())
  restaurantId String
  shiftId      String
  type         CashTransactionType
  amount       Decimal             @db.Decimal(10, 2)
  reason       String?
  paymentId    String?             @unique
  refundId     String?             @unique
  expenseId    String?             @unique
  createdById  String?
  createdAt    DateTime            @default(now())

  // Relationships
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  shift        CashierShift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  payment      Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refund       PaymentRefund?      @relation(fields: [refundId], references: [id], onDelete: SetNull)
  expense      Expense?            @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdByUser User?              @relation("CashTransactions", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([restaurantId, shiftId])
  @@index([restaurantId, type])
  @@index([restaurantId, createdAt])
  @@map("cash_transactions")
}

// -----------------------------------------------------------------------------
// 25. Kitchen Display System (KDS) & Stations
// -----------------------------------------------------------------------------
model KitchenStation {
  id           String                   @id @default(uuid())
  restaurantId String
  name         String
  code         String?
  displayOrder Int                      @default(0)
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  // Relationships
  restaurant   Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories   CategoryKitchenStation[]
  orderItems   OrderItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@map("kitchen_stations")
}

model CategoryKitchenStation {
  id         String         @id @default(uuid())
  stationId  String
  categoryId String
  createdAt  DateTime       @default(now())

  // Relationships
  station    KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([stationId, categoryId])
  @@index([stationId])
  @@index([categoryId])
  @@map("category_kitchen_stations")
}

// -----------------------------------------------------------------------------
// 26. Inventory & Stock Management Models
// -----------------------------------------------------------------------------
enum StockMovementType {
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  SALE_CONSUMPTION
  ORDER_VOID_RETURN
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  WASTAGE
  TRANSFER_IN
  TRANSFER_OUT
}

model StockLocation {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  code         String?
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  inventoryItems   InventoryItem[]
  fromMovements    StockMovement[]   @relation("FromLocationMovements")
  toMovements      StockMovement[]   @relation("ToLocationMovements")
  purchaseOrders   PurchaseOrder[]
  stockAdjustments StockAdjustment[]
  stockWastages    StockWastage[]
  fromTransfers    StockTransfer[]   @relation("FromLocationTransfers")
  toTransfers      StockTransfer[]   @relation("ToLocationTransfers")

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@map("stock_locations")
}

model Supplier {
  id            String          @id @default(uuid())
  restaurantId  String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  taxNumber     String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relationships
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  inventoryItems  InventoryItem[]
  purchaseOrders  PurchaseOrder[]
  purchaseReturns PurchaseReturn[]
  expenses        Expense[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@map("suppliers")
}

model InventoryItem {
  id               String   @id @default(uuid())
  restaurantId     String
  supplierId       String?
  locationId       String?
  itemCode         String
  name             String
  description      String?
  unit             String   @default("PCS") // KG, G, L, ML, PCS, PORTION, PACK, CAN, BOTTLE
  costPerUnit      Decimal  @default(0) @db.Decimal(10, 2)
  currentStock     Decimal  @default(0) @db.Decimal(12, 4)
  minStockLevel    Decimal  @default(0) @db.Decimal(12, 4)
  targetStockLevel Decimal? @db.Decimal(12, 4)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  restaurant           Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier             Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location             StockLocation?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  recipes              MenuItemIngredient[]
  movements            StockMovement[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  stockWastageItems    StockWastageItem[]
  stockTransferItems   StockTransferItem[]

  @@unique([restaurantId, itemCode])
  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@index([restaurantId, locationId])
  @@index([restaurantId, supplierId])
  @@map("inventory_items")
}

model MenuItemIngredient {
  id              String   @id @default(uuid())
  restaurantId    String
  menuItemId      String?
  variantId       String?
  modifierId      String?
  inventoryItemId String
  quantity        Decimal  @db.Decimal(12, 4)
  wastePercentage Decimal  @default(0) @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem      MenuItem?        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variant       MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  modifier      Modifier?        @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([restaurantId])
  @@index([menuItemId])
  @@index([variantId])
  @@index([modifierId])
  @@index([inventoryItemId])
  @@map("menu_item_ingredients")
}

model StockMovement {
  id              String            @id @default(uuid())
  restaurantId    String
  inventoryItemId String
  fromLocationId  String?
  toLocationId    String?
  type            StockMovementType
  quantityChange  Decimal           @db.Decimal(12, 4)
  balanceAfter    Decimal           @db.Decimal(12, 4)
  unitCost        Decimal           @default(0) @db.Decimal(10, 2)
  totalCost       Decimal           @default(0) @db.Decimal(10, 2)
  referenceType   String? // ORDER, PURCHASE_ORDER, PURCHASE_RETURN, ADJUSTMENT, WASTAGE, TRANSFER
  referenceId     String?
  reason          String?
  createdById     String?
  createdAt       DateTime          @default(now())

  // Relationships
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  fromLocation  StockLocation? @relation("FromLocationMovements", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation    StockLocation? @relation("ToLocationMovements", fields: [toLocationId], references: [id], onDelete: SetNull)
  createdByUser User?          @relation("CreatedStockMovements", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([inventoryItemId])
  @@index([restaurantId, type])
  @@index([restaurantId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  restaurantId         String
  supplierId           String?
  locationId           String?
  orderNumber          String
  invoiceNumber        String?
  status               String              @default("RECEIVED") // DRAFT, ORDERED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  subtotal             Decimal             @default(0) @db.Decimal(10, 2)
  taxAmount            Decimal             @default(0) @db.Decimal(10, 2)
  discountAmount       Decimal             @default(0) @db.Decimal(10, 2)
  totalCost            Decimal             @default(0) @db.Decimal(10, 2)
  totalAmount          Decimal             @default(0) @db.Decimal(10, 2)
  orderedAt            DateTime?
  expectedDeliveryDate DateTime?
  receivedAt           DateTime?           @default(now())
  notes                String?
  createdById          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // Relationships
  restaurant           Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier             Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location             StockLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items                PurchaseOrderItem[]
  returns              PurchaseReturn[]
  createdByUser        User?               @relation("CreatedPurchaseOrders", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([supplierId])
  @@index([locationId])
  @@index([restaurantId, status])
  @@index([restaurantId, receivedAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String               @id @default(uuid())
  purchaseOrderId  String
  inventoryItemId  String
  quantity         Decimal              @db.Decimal(12, 4)
  quantityReceived Decimal              @default(0) @db.Decimal(12, 4)
  unitCost         Decimal              @db.Decimal(10, 2)
  taxRate          Decimal              @default(0) @db.Decimal(5, 2)
  discountRate     Decimal              @default(0) @db.Decimal(5, 2)
  subtotal         Decimal              @default(0) @db.Decimal(10, 2)
  totalCost        Decimal              @db.Decimal(10, 2)

  // Relationships
  purchaseOrder    PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem    InventoryItem        @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  returnItems      PurchaseReturnItem[]

  @@index([purchaseOrderId])
  @@index([inventoryItemId])
  @@map("purchase_order_items")
}

model PurchaseReturn {
  id                String               @id @default(uuid())
  restaurantId      String
  purchaseOrderId   String
  supplierId        String?
  returnNumber      String
  reason            String
  totalRefundAmount Decimal              @default(0) @db.Decimal(10, 2)
  status            String               @default("COMPLETED") // COMPLETED, CANCELLED
  notes             String?
  createdById       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // Relationships
  restaurant        Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  purchaseOrder     PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplier          Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items             PurchaseReturnItem[]
  createdByUser     User?                @relation("CreatedPurchaseReturns", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([restaurantId, returnNumber])
  @@index([restaurantId])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([restaurantId, createdAt])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id                  String             @id @default(uuid())
  purchaseReturnId    String
  purchaseOrderItemId String?
  inventoryItemId     String
  quantity            Decimal            @db.Decimal(12, 4)
  unitCost            Decimal            @db.Decimal(10, 2)
  totalAmount         Decimal            @db.Decimal(10, 2)

  // Relationships
  purchaseReturn      PurchaseReturn     @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  inventoryItem       InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([purchaseReturnId])
  @@index([purchaseOrderItemId])
  @@index([inventoryItemId])
  @@map("purchase_return_items")
}

model StockAdjustment {
  id                     String                @id @default(uuid())
  restaurantId           String
  locationId             String?
  adjustmentNumber       String
  reason                 String
  totalItemsAdjusted     Int                   @default(0)
  netValuationDifference Decimal               @default(0) @db.Decimal(10, 2)
  notes                  String?
  createdById            String?
  createdAt              DateTime              @default(now())

  // Relationships
  restaurant    Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  location      StockLocation?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items         StockAdjustmentItem[]
  createdByUser User?                 @relation("CreatedStockAdjustments", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([restaurantId, adjustmentNumber])
  @@index([restaurantId])
  @@index([locationId])
  @@index([restaurantId, createdAt])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                  String          @id @default(uuid())
  adjustmentId        String
  inventoryItemId     String
  previousStock       Decimal         @db.Decimal(12, 4)
  actualStock         Decimal         @db.Decimal(12, 4)
  difference          Decimal         @db.Decimal(12, 4)
  unitCost            Decimal         @db.Decimal(10, 2)
  valuationDifference Decimal         @db.Decimal(10, 2)

  // Relationships
  adjustment    StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([adjustmentId])
  @@index([inventoryItemId])
  @@map("stock_adjustment_items")
}

model StockWastage {
  id               String             @id @default(uuid())
  restaurantId     String
  locationId       String?
  wastageNumber    String
  reason           String // EXPIRED, SPOILED, PREPARATION_ERROR, DAMAGED, CONTAMINATED, OTHER
  notes            String?
  totalWastedValue Decimal            @default(0) @db.Decimal(10, 2)
  createdById      String?
  createdAt        DateTime           @default(now())

  // Relationships
  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  location      StockLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items         StockWastageItem[]
  createdByUser User?              @relation("CreatedStockWastages", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([restaurantId, wastageNumber])
  @@index([restaurantId])
  @@index([locationId])
  @@index([restaurantId, createdAt])
  @@map("stock_wastages")
}

model StockWastageItem {
  id              String        @id @default(uuid())
  wastageId       String
  inventoryItemId String
  quantity        Decimal       @db.Decimal(12, 4)
  unitCost        Decimal       @db.Decimal(10, 2)
  totalCost       Decimal       @db.Decimal(10, 2)
  itemReason      String?

  // Relationships
  wastage       StockWastage  @relation(fields: [wastageId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([wastageId])
  @@index([inventoryItemId])
  @@map("stock_wastage_items")
}

model StockTransfer {
  id             String              @id @default(uuid())
  restaurantId   String
  fromLocationId String
  toLocationId   String
  transferNumber String
  status         String              @default("COMPLETED") // COMPLETED, CANCELLED
  notes          String?
  createdById    String?
  createdAt      DateTime            @default(now())

  // Relationships
  restaurant    Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  fromLocation  StockLocation       @relation("FromLocationTransfers", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation    StockLocation       @relation("ToLocationTransfers", fields: [toLocationId], references: [id], onDelete: Restrict)
  items         StockTransferItem[]
  createdByUser User?               @relation("CreatedStockTransfers", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([restaurantId, transferNumber])
  @@index([restaurantId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([restaurantId, createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id              String        @id @default(uuid())
  transferId      String
  inventoryItemId String
  quantity        Decimal       @db.Decimal(12, 4)
  unitCost        Decimal       @db.Decimal(10, 2)

  // Relationships
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([inventoryItemId])
  @@map("stock_transfer_items")
}

// -----------------------------------------------------------------------------
// 34. Discounts & Promotions Engine
// -----------------------------------------------------------------------------
enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
  FREE_ITEM
}

enum PromotionTargetType {
  ORDER
  ITEM
  CATEGORY
}

model Promotion {
  id                    String              @id @default(uuid())
  restaurantId          String
  name                  String
  code                  String?
  description           String?
  type                  PromotionType       @default(PERCENTAGE)
  targetType            PromotionTargetType @default(ORDER)
  discountValue         Decimal             @default(0) @db.Decimal(10, 2)
  maxDiscountAmount     Decimal?            @db.Decimal(10, 2)
  minOrderAmount        Decimal?            @db.Decimal(10, 2)
  minQuantity           Int?
  buyQuantity           Int?
  getQuantity           Int?
  getDiscountPercentage Decimal?            @default(100) @db.Decimal(5, 2)
  orderTypes            Json?               @db.JsonB
  daysOfWeek            Json?               @db.JsonB
  startDate             DateTime?
  endDate               DateTime?
  startTime             String?
  endTime               String?
  isActive              Boolean             @default(true)
  isAutoApply           Boolean             @default(false)
  isStackable           Boolean             @default(false)
  priority              Int                 @default(0)
  usageLimit            Int?
  usageCount            Int                 @default(0)
  perCustomerLimit      Int?
  customerId            String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relationships
  restaurant            Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer              Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  menuItems             PromotionMenuItem[]
  categories            PromotionCategory[]
  usages                PromotionUsage[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@index([restaurantId, isAutoApply])
  @@index([restaurantId, code])
  @@index([restaurantId, priority])
  @@map("promotions")
}

model PromotionMenuItem {
  id           String    @id @default(uuid())
  promotionId  String
  menuItemId   String

  // Relationships
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  menuItem     MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([promotionId, menuItemId])
  @@index([promotionId])
  @@index([menuItemId])
  @@map("promotion_menu_items")
}

model PromotionCategory {
  id           String    @id @default(uuid())
  promotionId  String
  categoryId   String

  // Relationships
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([promotionId, categoryId])
  @@index([promotionId])
  @@index([categoryId])
  @@map("promotion_categories")
}

model PromotionUsage {
  id             String     @id @default(uuid())
  restaurantId   String
  promotionId    String
  orderId        String
  customerId     String?
  discountAmount Decimal    @db.Decimal(10, 2)
  details        Json?      @db.JsonB
  usedAt         DateTime   @default(now())

  // Relationships
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  promotion      Promotion  @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([promotionId])
  @@index([orderId])
  @@index([customerId])
  @@index([restaurantId, usedAt])
  @@map("promotion_usages")
}

// -----------------------------------------------------------------------------
// 39. Loyalty & Customer Rewards
// -----------------------------------------------------------------------------
enum LoyaltyTransactionType {
  EARN
  REDEEM
  MANUAL_ADJUSTMENT
  REFUND_REVERSAL
  EXPIRY
}

enum LoyaltyRoundingMode {
  FLOOR
  ROUND
  CEIL
}

model LoyaltyProgram {
  id                    String              @id @default(uuid())
  restaurantId          String              @unique
  isEnabled             Boolean             @default(true)
  programName           String              @default("Faraz Rewards")
  pointsPerCurrencyUnit Float               @default(1.0)
  redemptionRate        Decimal             @default(0.01) @db.Decimal(10, 4)
  minPointsToRedeem     Int                 @default(50)
  maxPointsPerOrder     Int?
  maxDiscountPercentage Float               @default(100.0)
  pointsExpiryDays      Int?
  roundingMode          LoyaltyRoundingMode @default(FLOOR)
  minOrderSubtotal      Decimal             @default(0.00) @db.Decimal(10, 2)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relationships
  restaurant            Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("loyalty_programs")
}

model LoyaltyTier {
  id                 String           @id @default(uuid())
  restaurantId       String
  name               String
  minPoints          Int              @default(0)
  multiplier         Float            @default(1.0)
  discountPercentage Float            @default(0.0)
  color              String?
  sortOrder          Int              @default(0)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relationships
  restaurant         Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  accounts           LoyaltyAccount[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, isActive, sortOrder])
  @@map("loyalty_tiers")
}

model LoyaltyAccount {
  id                  String               @id @default(uuid())
  restaurantId        String
  customerId          String               @unique
  tierId              String?
  pointsBalance       Int                  @default(0)
  lifetimePoints      Int                  @default(0)
  totalRedeemedPoints Int                  @default(0)
  isActive            Boolean              @default(true)
  joinedAt            DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Relationships
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tier                LoyaltyTier?         @relation(fields: [tierId], references: [id], onDelete: SetNull)
  transactions        LoyaltyTransaction[]

  @@index([restaurantId])
  @@index([customerId])
  @@index([restaurantId, isActive])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id                 String                 @id @default(uuid())
  restaurantId       String
  accountId          String
  customerId         String
  orderId            String?
  paymentId          String?
  type               LoyaltyTransactionType
  points             Int
  pointsBalanceAfter Int
  monetaryValue      Decimal?               @db.Decimal(10, 2)
  reason             String?
  managerPinVerified Boolean                @default(false)
  createdById        String?
  createdAt          DateTime               @default(now())

  // Relationships
  restaurant         Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  account            LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer           Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order              Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdByUser      User?                  @relation("CreatedLoyaltyTransactions", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([accountId])
  @@index([customerId])
  @@index([orderId])
  @@index([restaurantId, type])
  @@index([restaurantId, createdAt])
  @@map("loyalty_transactions")
}

// -----------------------------------------------------------------------------
// 40. Reservations & Table Bookings
// -----------------------------------------------------------------------------
enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id               String            @id @default(uuid())
  restaurantId     String
  reservationCode  String
  customerId       String?
  customerName     String
  customerPhone    String
  customerEmail    String?
  guestCount       Int               @default(2)
  tableId          String?
  reservationDate  DateTime          @db.Date
  startTime        DateTime
  endTime          DateTime
  durationMinutes  Int               @default(90)
  status           ReservationStatus @default(CONFIRMED)
  specialRequests  String?
  cancelReason     String?
  seatedAt         DateTime?
  completedAt      DateTime?
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relationships
  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table            RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  createdByUser    User?             @relation("CreatedReservations", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([restaurantId, reservationCode])
  @@index([restaurantId])
  @@index([tableId])
  @@index([customerId])
  @@index([restaurantId, reservationDate])
  @@index([restaurantId, status])
  @@index([restaurantId, startTime, endTime])
  @@map("reservations")
}

enum ExpenseStatus {
  RECORDED
  VOIDED
}

// -----------------------------------------------------------------------------
// 41. Expense & Cash Drawer Management
// -----------------------------------------------------------------------------
model ExpenseCategory {
  id           String     @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@map("expense_categories")
}

model Expense {
  id              String           @id @default(uuid())
  restaurantId    String
  categoryId      String
  supplierId      String?
  shiftId         String?
  expenseNumber   String
  amount          Decimal          @db.Decimal(10, 2)
  paymentMethod   PaymentMethod    @default(CASH)
  status          ExpenseStatus    @default(RECORDED)
  date            DateTime         @default(now())
  businessDate    String
  description     String
  reference       String?
  receiptUrl      String?
  notes           String?
  voidReason      String?
  voidedAt        DateTime?
  voidedById      String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relationships
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category        ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  shift           CashierShift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cashTransaction CashTransaction?
  createdByUser   User?            @relation("CreatedExpenses", fields: [createdById], references: [id], onDelete: SetNull)
  voidedByUser    User?            @relation("VoidedExpenses", fields: [voidedById], references: [id], onDelete: SetNull)

  @@unique([restaurantId, expenseNumber])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, businessDate])
  @@index([restaurantId, date])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, paymentMethod])
  @@index([restaurantId, shiftId])
  @@index([restaurantId, supplierId])
  @@map("expenses")
}






